{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0",
        "doctrine/dbal": "^2.5",

        "guzzlehttp/guzzle": "^7.0",
        "spatie/laravel-permission": "^5.0",
        "maatwebsite/excel": "^3.1",
        "aws/aws-sdk-php-laravel": "^3.1",

        "league/flysystem": "^3.0",
        "mathjax/mathjax": "^2.7",
        "predis/predis": "^1.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.20",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^8.5",
        "phpspec/phpspec": "^7.0"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Http/helpers.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "echo 'Skipping post-install scripts due to upgrade compatibility'"
        ],
        "pre-update-cmd": [
            "echo 'Skipping pre-update script due to PHP 8.0 compatibility'"
        ],
        "post-update-cmd": [
            "echo 'Skipping post-update scripts due to upgrade compatibility'"
        ],
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
