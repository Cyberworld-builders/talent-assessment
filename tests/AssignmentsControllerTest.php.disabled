    /**
     * Test assignment creation with multiple assessments
     */
    public function testAssignmentCreationWithMultipleAssessments()
    {
        $this->be($this->user);

        // Create additional assessment
        $assessment2 = Assessment::create([
            'name' => 'Test Assessment 2',
            'description' => 'Second test assessment',
            'target' => 0,
            'active' => 1,
            'user_id' => $this->user->id
        ]);

        $formData = [
            'assessments' => [$this->assessment->id, $assessment2->id],
            'user' => [$this->user->id],
            'target' => [0],
            'role' => [''],
            'expiration' => Carbon::tomorrow()->format('d M Y'),
            'send-email' => 0,
            'job_id' => $this->job->id
        ];

        $response = $this->call('POST', "dashboard/clients/{$this->client->id}/assign", $formData);

        $this->assertEquals(302, $response->getStatusCode());
        
        // Verify assignments were created for both assessments
        $assignments = Assignment::where('user_id', $this->user->id)->get();
        $this->assertCount(2, $assignments);
        
        $assessmentIds = $assignments->pluck('assessment_id')->toArray();
        $this->assertContains($this->assessment->id, $assessmentIds);
        $this->assertContains($assessment2->id, $assessmentIds);
    }

