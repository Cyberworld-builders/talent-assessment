    /**
     * Test assignment creation error handling
     */
    public function testAssignmentCreationErrorHandling()
    {
        $this->be($this->user);

        // Test with invalid assessment ID
        $formData = [
            'assessments' => [99999], // Non-existent assessment
            'user' => [$this->user->id],
            'target' => [0],
            'role' => [''],
            'expiration' => Carbon::tomorrow()->format('d M Y'),
            'send-email' => 0,
            'job_id' => $this->job->id
        ];

        $response = $this->call('POST', "dashboard/clients/{$this->client->id}/assign", $formData);

        // Should handle error gracefully
        $this->assertTrue(in_array($response->getStatusCode(), [302, 500]));
    }

